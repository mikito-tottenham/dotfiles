# Copy this file to ~/.config/op/dotfiles.env and replace the references.
# Keep ~/.config/op/dotfiles.env out of git; it may reveal private vault,
# item, and field names even though it must not contain secret values.

# EXAMPLE_API_KEY=op://<vault>/<item>/<field>
# EXAMPLE_TOKEN=op://<vault>/<item>/<field>
# SLACK_API_TOKEN=op://<vault>/<item>/<field>
# slack-account <profile> は SLACK_<PROFILE>_TOKEN を読む (profile を大文字化、- は _)
# SLACK_TWIN_TOKEN=op://<vault>/<item>/<field>
