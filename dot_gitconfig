[url "https://"]
	insteadOf = git://
[user]
	email = 32815656+mikito-tottenham@users.noreply.github.com
	name = Mikito Ebishima
# gh は GH_TOKEN を受け取る必要があるため、helper 側で ghrun を噛ませる。
# ghrun は 1Password から materialize した ~/.config/op/injected/github.env を
# 読むだけで op を呼ばないので、push / fetch のたびに Touch ID を求められない。
# status / log / diff / commit などのローカル操作は従来どおり token に触れない。
# ファイルが無いときは ghrun が `ghrun --refresh` を案内して失敗する（→ ADR-0063）。
[credential "https://github.com"]
	helper =
	helper = !ghrun gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !ghrun gh auth git-credential
