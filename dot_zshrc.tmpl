
# Added by LM Studio CLI (lms)
export PATH="$PATH:{{ .chezmoi.homeDir }}/.lmstudio/bin":$HOME/.nodebrew/current/bin/
# End of LM Studio CLI section

eval "$(direnv hook zsh)"

# for Android studio
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
export PATH="$JAVA_HOME/bin:$PATH"

. "$HOME/.local/bin/env"
export PATH=$PATH:$HOME/.maestro/bin

# Entire CLI shell completion
# entire が未インストールのマシンでは補完の読み込みを飛ばす（無いとシェル起動ごとにエラー）
autoload -Uz compinit && compinit
if command -v entire >/dev/null 2>&1; then
  source <(entire completion zsh)
fi

alias gh='ghrun gh'
# gh は 1Password から materialize した GH_TOKEN を ghrun 経由で受け取る。
# oprun gh だと呼ぶたびに 1Password の認可（10 分無操作で失効）を求められ、
# 作業のたびに Touch ID が必要だったため（→ ADR-0063）。再生成は `ghrun --refresh`。
# git は包まない。GitHub への通信に要る GH_TOKEN は ~/.gitconfig の
# credential helper (!ghrun gh auth git-credential) が必要なときだけ読む。
