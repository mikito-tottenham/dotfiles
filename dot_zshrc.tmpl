
# Added by LM Studio CLI (lms)
export PATH="$PATH:{{ .chezmoi.homeDir }}/.lmstudio/bin":$HOME/.nodebrew/current/bin/
# End of LM Studio CLI section

eval "$(direnv hook zsh)"

# for Android studio
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
export PATH="$JAVA_HOME/bin:$PATH"

. "$HOME/.local/bin/env"
export PATH=$PATH:$HOME/.maestro/bin

# Entire CLI shell completion
autoload -Uz compinit && compinit && source <(entire completion zsh)

alias gh='oprun gh'
# git は oprun で包まない。包むと status / log / diff などのローカル操作まで
# 1Password の認可待ちになり、ロック中や非対話セッションで全て失敗するため。
# GitHub への通信に要る GH_TOKEN は ~/.gitconfig の credential helper
# (!oprun gh auth git-credential) が必要なときだけ取りに行く。
