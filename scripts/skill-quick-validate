#!/usr/bin/env python3
"""Validate one or more skills without requiring third-party Python packages.

Usage: scripts/skill-quick-validate <skill_directory> [<skill_directory> ...]

Each description longer than DESCRIPTION_BUDGET characters (Python `len`) prints a
WARN without changing the exit code; the hard limit of 1024 characters stays an error.
With several skill directories (for example `skills/*`), the total description length
is printed at the end so the combined budget stays visible.
"""

from __future__ import annotations

import hashlib
import re
import sys
from pathlib import Path

MAX_SKILL_NAME_LENGTH = 64
MAX_DESCRIPTION_LENGTH = 1024
DESCRIPTION_BUDGET = 500
RUNNER_COMMON_RELPATH = Path("references") / "runner-common.md"
ALLOWED_PROPERTIES = {"name", "description", "license", "allowed-tools", "metadata"}


def split_header_value(line: str) -> tuple[str, str] | None:
    if ":" not in line:
        return None
    key, value = line.split(":", 1)
    return key.strip(), value.strip()


def consume_block(lines: list[str], start: int, indicator: str) -> tuple[str, int]:
    folded = indicator.startswith(">")
    idx = start + 1
    chunks: list[str] = []
    while idx < len(lines):
        line = lines[idx]
        if line.strip() == "---":
            break
        if line and not line.startswith((" ", "\t")):
            break
        stripped = line.lstrip(" \t")
        chunks.append(stripped.strip() if folded else stripped.rstrip("\n"))
        idx += 1
    if folded:
        return " ".join(part for part in chunks if part).strip(), idx
    return "\n".join(chunks).strip(), idx


def parse_frontmatter(skill_md: Path) -> tuple[dict[str, str], list[str], str | None]:
    try:
        text = skill_md.read_text(encoding="utf-8")
    except OSError as exc:
        return {}, [], f"Could not read SKILL.md: {exc}"

    if not text.startswith("---\n"):
        return {}, [], "No YAML frontmatter found"

    lines = text.splitlines()
    frontmatter: dict[str, str] = {}
    warnings: list[str] = []
    idx = 1
    while idx < len(lines):
        line = lines[idx]
        if line.strip() == "---":
            return frontmatter, warnings, None
        if not line.strip():
            idx += 1
            continue
        if line.startswith((" ", "\t")):
            idx += 1
            continue

        parsed = split_header_value(line)
        if parsed is None:
            warnings.append(f"unsupported frontmatter line: {line}")
            idx += 1
            continue

        key, value = parsed
        if value in {">", ">-", ">+", "|", "|-", "|+"}:
            frontmatter[key], idx = consume_block(lines, idx, value)
            continue
        if value.startswith(('"', "'")) and value.endswith(('"', "'")) and len(value) >= 2:
            value = value[1:-1]
        frontmatter[key] = value
        idx += 1

    return frontmatter, warnings, "Invalid frontmatter format"


def check_runner_common(skill_path: Path) -> str | None:
    """Require identical references/runner-common.md copies across sibling *-cli-runner skills."""
    if not (skill_path / RUNNER_COMMON_RELPATH).is_file():
        return None
    copies = sorted(skill_path.resolve().parent.glob(f"*-cli-runner/{RUNNER_COMMON_RELPATH.as_posix()}"))
    digests = {path: hashlib.md5(path.read_bytes()).hexdigest() for path in copies}
    if len(set(digests.values())) <= 1:
        return None
    detail = ", ".join(f"{path.parent.parent.name}={digest[:8]}" for path, digest in digests.items())
    return f"{RUNNER_COMMON_RELPATH.as_posix()} differs across cli-runner skills (md5): {detail}"


def validate_skill(skill_path: Path) -> tuple[bool, str, int]:
    """Return (valid, message, description_length). Length is 0 when the description could not be read."""
    skill_md = skill_path / "SKILL.md"
    if not skill_md.exists():
        return False, "SKILL.md not found", 0

    frontmatter, warnings, error = parse_frontmatter(skill_md)
    if error:
        return False, error, 0

    unexpected_keys = set(frontmatter) - ALLOWED_PROPERTIES
    if unexpected_keys:
        allowed = ", ".join(sorted(ALLOWED_PROPERTIES))
        unexpected = ", ".join(sorted(unexpected_keys))
        return False, f"Unexpected key(s) in SKILL.md frontmatter: {unexpected}. Allowed properties are: {allowed}", 0

    if "name" not in frontmatter:
        return False, "Missing 'name' in frontmatter", 0
    if "description" not in frontmatter:
        return False, "Missing 'description' in frontmatter", 0

    name = frontmatter.get("name", "").strip()
    description = frontmatter.get("description", "").strip()
    desc_len = len(description)
    if not name:
        return False, "Name must be a non-empty string", desc_len
    if not re.match(r"^[a-z0-9-]+$", name):
        return False, f"Name '{name}' should be hyphen-case (lowercase letters, digits, and hyphens only)", desc_len
    if name.startswith("-") or name.endswith("-") or "--" in name:
        return False, f"Name '{name}' cannot start/end with hyphen or contain consecutive hyphens", desc_len
    if len(name) > MAX_SKILL_NAME_LENGTH:
        return False, f"Name is too long ({len(name)} characters). Maximum is {MAX_SKILL_NAME_LENGTH} characters.", desc_len

    if not description:
        return False, "Description must be a non-empty string", desc_len
    if "<" in description or ">" in description:
        return False, "Description cannot contain angle brackets (< or >)", desc_len
    if desc_len > MAX_DESCRIPTION_LENGTH:
        return False, f"Description is too long ({desc_len} characters). Maximum is {MAX_DESCRIPTION_LENGTH} characters.", desc_len

    if warnings:
        return False, "; ".join(warnings), desc_len

    runner_common_error = check_runner_common(skill_path)
    if runner_common_error:
        return False, runner_common_error, desc_len
    return True, f"Skill is valid! (description {desc_len} chars)", desc_len


def main() -> int:
    paths = [Path(arg) for arg in sys.argv[1:]]
    if not paths:
        print("Usage: scripts/skill-quick-validate <skill_directory> [<skill_directory> ...]")
        return 1

    all_valid = True
    total_len = 0
    prefix = len(paths) > 1
    for skill_path in paths:
        valid, message, desc_len = validate_skill(skill_path)
        all_valid = all_valid and valid
        total_len += desc_len
        label = f"{skill_path}: " if prefix else ""
        print(f"{label}{message}")
        if desc_len > DESCRIPTION_BUDGET:
            print(f"{label}WARN: description is {desc_len} chars; budget is {DESCRIPTION_BUDGET}")

    if prefix:
        print(f"description total: {total_len} chars across {len(paths)} skills")
    return 0 if all_valid else 1


if __name__ == "__main__":
    raise SystemExit(main())
